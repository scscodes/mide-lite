<workflow id="bug-fix">
  <name>Bug Fix Protocol</name>
  <trigger>fix bug, broken, failing test, regression, quick fix</trigger>
  <description>Quick diagnostic-driven resolution for isolated issues.</description>
  <mode>sequential</mode>
  <steps>
    <step sequence="1" agent="builder">
      <goal>Reproduce the issue and create a failing test case.</goal>
      <output>test_plan</output>
    </step>
    <step sequence="2" agent="builder" receives="test_plan">
      <goal>Implement the fix.</goal>
      <output>code</output>
    </step>
    <step sequence="3" agent="critic" receives="code, test_plan">
      <goal>Verify the fix and ensure no regression.</goal>
      <output>review_report</output>
    </step>
  </steps>
  <on_critical_findings max_iterations="2">
    <step agent="builder" receives="review_report, code">
      <goal>Address critical and high-severity findings.</goal>
      <output>code</output>
    </step>
    <step agent="critic" receives="code">
      <goal>Verify all critical findings resolved.</goal>
      <output>review_report</output>
    </step>
  </on_critical_findings>
</workflow>
