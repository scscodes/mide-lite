<workflow id="feature-dev">
  <name>Feature Development</name>
  <trigger>new feature, add functionality, implement user story, build new</trigger>
  <description>End-to-end flow from design to implementation and review.</description>
  <mode>sequential</mode>
  <steps>
    <step sequence="1" agent="architect">
      <goal>Design the solution (API, Schema, Strategy).</goal>
      <output>design_doc</output>
    </step>
    <step sequence="2" agent="builder" receives="design_doc">
      <goal>Implement the design in code with tests.</goal>
      <output>code, test_plan</output>
    </step>
    <step sequence="3" agent="critic" receives="code, design_doc">
      <goal>Review implementation against design and rules.</goal>
      <output>review_report</output>
    </step>
  </steps>
  <on_critical_findings max_iterations="2">
    <step agent="builder" receives="review_report, code">
      <goal>Address critical and high-severity findings.</goal>
      <output>code</output>
    </step>
    <step agent="critic" receives="code">
      <goal>Verify all critical findings resolved.</goal>
      <output>review_report</output>
    </step>
  </on_critical_findings>
</workflow>
