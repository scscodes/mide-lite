<workflow id="refactor">
  <name>Technical Debt Reduction</name>
  <trigger>refactor, cleanup, simplify, reduce complexity, restructure</trigger>
  <description>Safe restructuring of existing code with validation.</description>
  <mode>sequential</mode>
  <steps>
    <step sequence="1" agent="critic" lens="maintainability">
      <goal>Analyze current implementation and identify specific improvements.</goal>
      <output>review_report</output>
    </step>
    <step sequence="2" agent="builder" receives="review_report">
      <goal>Apply refactoring based on critique.</goal>
      <output>code</output>
    </step>
    <step sequence="3" agent="critic" lens="maintainability" receives="code, review_report">
      <goal>Verify refactoring addressed identified issues without regression.</goal>
      <output>review_report</output>
    </step>
  </steps>
  <on_critical_findings max_iterations="2">
    <step agent="builder" receives="review_report, code">
      <goal>Address critical and high-severity findings.</goal>
      <output>code</output>
    </step>
    <step agent="critic" receives="code">
      <goal>Verify all critical findings resolved.</goal>
      <output>review_report</output>
    </step>
  </on_critical_findings>
</workflow>
